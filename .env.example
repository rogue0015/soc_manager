# Template for the secrets file. Copy it to `env` (no dot) and fill in your keys:
#
#     cp .env.example env
#
# `env` is gitignored: never commit real keys. Both ways of running read it:
#   - local dev (./scripts/dev.sh) reads the file directly
#   - Docker (compose.yaml) loads it into the backend container at start-up
# A platform with empty keys shows as "not connected"; the app still runs.

# --- X (Twitter) ------------------------------------------------------------
# developer.x.com → Projects & Apps → your app → Keys and tokens.
# Required for posting (OAuth 1.0a; the app needs "Read and write" permission):
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: only used by test_credentials/test_x_credentials.py
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_APP_ID=
