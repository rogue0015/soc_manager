# Template for the secrets file. Copy it to `env` (no dot), keep it private, fill in your keys:
#
#     cp .env.example env && chmod 660 env
#
# `env` is gitignored: never commit real keys. Both ways of running read it:
#   - local dev (./scripts/dev.sh) reads the file directly
#   - Docker (compose.yaml) mounts it into the backend container
# Signing in from the app (LinkedIn) writes the new token back into this file.
# A platform with empty keys shows as "not connected"; the app still runs.

# --- X (Twitter) ------------------------------------------------------------
# developer.x.com → Projects & Apps → your app → Keys and tokens.
# Required for posting (OAuth 1.0a; the app needs "Read and write" permission):
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: only used by test_credentials/test_x_credentials.py
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_APP_ID=

# --- LinkedIn ---------------------------------------------------------------
# linkedin.com/developers/apps → your app → Auth. Then press "Sign in with LinkedIn"
# on the Status tab. See README "LinkedIn setup".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional, only for the fallback scripts/linkedin_login.py if port 8765 is taken.
# LINKEDIN_REDIRECT_URI=http://localhost:8765/linkedin/callback

# Optional: permissions to ask for. Add r_member_postAnalytics only after LinkedIn has
# approved your app for its Community Management API (automatic per-post stats).
# LINKEDIN_SCOPES=openid profile w_member_social

# Written by the sign-in; leave empty. The token lasts 60 days; sign in again to renew it.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_GRANTED_SCOPES=

# --- dev.to -------------------------------------------------------------------
# dev.to → Settings → Extensions → DEV Community API Keys → Generate API Key.
# Publishes blog posts as articles and reads their views, reactions and comments.
DEVTO_API_KEY=

# --- Bluesky ------------------------------------------------------------------
# bsky.app → Settings → Privacy and security → App passwords → Add App Password.
# Use an app password, never your account password. Handle as in yourname.bsky.social.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Optional: your server, if your account isn't hosted by Bluesky itself.
# BLUESKY_SERVICE=https://bsky.social

# --- Meta: Facebook and Instagram (not used yet: adapters planned) -----------
# developers.facebook.com/apps → your app → App settings → Basic.
META_APP_ID=
META_APP_SECRET=

# --- Threads (not used yet: adapter planned) ---------------------------------
# Your Meta app → Use cases → Threads API → Settings: Threads app ID and secret.
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- YouTube ------------------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application).
# Then "Sign in with YouTube" on the Status tab. See README "YouTube setup".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Written by the sign-in; leave empty.
YOUTUBE_REFRESH_TOKEN=

# --- TikTok -------------------------------------------------------------------
# developers.tiktok.com/apps → your app (Login Kit + Content Posting API). See README "TikTok setup".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Written by the sign-in, and again on every refresh; leave empty.
TIKTOK_REFRESH_TOKEN=
TIKTOK_REFRESH_EXPIRES_AT=
TIKTOK_OPEN_ID=

# --- Instagram (Reels; inactive until Meta's review) --------------------------
# Meta app → Instagram API with Instagram Login → Instagram app ID and secret. See README "Instagram setup".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Written by the sign-in; leave empty.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN_EXPIRES_AT=

# --- Gemini (AI generation tab) -----------------------------------------------
# aistudio.google.com/app/apikey → Create API key. See README "AI generation".
GEMINI_API_KEY=
# Optional: the model (default gemini-3.1-flash-lite) and your project's limits per minute / per day
# from aistudio.google.com/rate-limit (defaults 15 / 500). The app stays under them.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=15
# GEMINI_RPD=500
